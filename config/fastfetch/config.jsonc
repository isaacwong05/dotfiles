{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB",
    },
    "key": {
      "type": "icon",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "white",
        "host": "cyan",
      },
    },
    "os",
    "kernel",
    "wm",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "disk",
      "folders": ["/"],
    },
    "uptime",
    {
      "type": "colors",
      "key": "Colors",
      "block": {
        "range": [1, 6],
      },
    },
  ],
}
