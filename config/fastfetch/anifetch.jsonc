{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "padding": {
      "left": 20,
      "top": 4,
    },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB",
    },
    "key": {
      "type": "icon",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "red",
        "host": "blue",
      },
    },
    "break",
    "users",
    "os",
    "cpu",
    "gpu",
    "uptime",
    {
      "type": "colors",
      "key": "Colors",
      "block": {
        "range": [1, 6],
      },
    },
  ],
}
