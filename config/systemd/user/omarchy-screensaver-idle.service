[Unit]
Description=Omarchy screensaver idle monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell --no-duplicate --path %h/.config/quickshell/omarchy-screensaver-idle/shell.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
