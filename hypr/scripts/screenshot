#!/usr/bin/env bash
# Capture a selected Wayland region to the clipboard and confirm via mako.
set -euo pipefail

if grim -g "$(slurp)" - | wl-copy --type image/png; then
    notify-send --app-name="Screenshot" --icon="camera-photo" --urgency=low \
        "Screenshot copied" "Selected area copied to clipboard."
fi
